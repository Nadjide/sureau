# Configuration d'une instance Sureau, à copier dans un fichier ignoré par Git
# (par exemple .env.instance) puis à passer à Docker Compose avec --env-file.
# Ne publiez jamais ce fichier une fois rempli.

# Mot de passe de la base PostgreSQL de cette instance. Obligatoire.
# Utilisez une valeur aléatoire propre à l'instance, par exemple :
#   openssl rand -hex 32
SUREAU_DB_PASSWORD=

# Clé demandée une seule fois pour créer le premier compte administrateur.
# Obligatoire. Une valeur aléatoire propre à l'instance convient, par exemple :
#   openssl rand -hex 24
SUREAU_SETUP_TOKEN=

# Adresse et port d'écoute de l'interface HTTP. Par défaut, seule la machine
# locale peut s'y connecter ; exposez Sureau par un proxy HTTPS.
SUREAU_HTTP_BIND=127.0.0.1
SUREAU_HTTP_PORT=8080

# Passez à true dès que l'instance est servie en HTTPS : le cookie de session
# n'est alors plus envoyé en clair.
SUREAU_COOKIE_SECURE=false

# Image de l'application. Par défaut, elle est construite localement à partir
# de ces sources.
SUREAU_IMAGE=sureau:local
