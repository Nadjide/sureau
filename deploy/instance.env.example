# Configuration d'une instance Sureau. deploy/sureau.sh init (ou sureau.ps1 init)
# la crée à partir de ce gabarit avec des secrets aléatoires, dans un fichier
# ignoré par Git (.env.instance). Pour la remplir à la main, copiez ce gabarit
# puis passez le fichier à Docker Compose avec --env-file.
# Ne publiez jamais ce fichier une fois rempli.

# Mot de passe de la base PostgreSQL de cette instance. Obligatoire.
# Utilisez une valeur aléatoire propre à l'instance, par exemple :
#   openssl rand -hex 32
SUREAU_DB_PASSWORD=

# Clé demandée une seule fois pour créer le premier compte administrateur.
# Obligatoire. Une valeur aléatoire propre à l'instance convient, par exemple :
#   openssl rand -hex 24
SUREAU_SETUP_TOKEN=

# Adresse et port d'écoute de l'interface HTTP. Par défaut, seule la machine
# locale peut s'y connecter ; exposez Sureau par un proxy HTTPS.
SUREAU_HTTP_BIND=127.0.0.1
SUREAU_HTTP_PORT=8080

# Passez à true dès que l'instance est servie en HTTPS : le cookie de session
# n'est alors plus envoyé en clair.
SUREAU_COOKIE_SECURE=false

# Nom du cookie de session. Par défaut SUREAU_SESSION_<port>, propre à chaque
# instance de la machine : les navigateurs ne distinguent pas les cookies par
# port. Lettres, chiffres, « _ » et « - » seulement.
# SUREAU_COOKIE_NAME=

# Connexion d'entreprise (OpenID Connect : Microsoft Entra ID, Google Workspace,
# Keycloak…), facultative. Elle n'ouvre que les comptes existants dont l'e-mail,
# renseigné par un administrateur, correspond à l'identité du fournisseur.
# Adresse de retour à déclarer chez le fournisseur : <adresse>/login/oauth2/code/oidc
# SUREAU_OIDC_ISSUER=https://login.microsoftonline.com/<locataire>/v2.0
# SUREAU_OIDC_CLIENT_ID=
# SUREAU_OIDC_CLIENT_SECRET=
# Nom affiché sur le bouton de connexion, par exemple « Microsoft ».
# SUREAU_OIDC_NAME=

# Image de l'application. Par défaut (sureau:local), elle est construite
# localement à partir de ces sources. Indiquez une image publiée, de préférence
# avec sa version précise, pour la télécharger à la place (sans les sources) :
#   SUREAU_IMAGE=ghcr.io/<propriétaire>/sureau:<version>
# Un registre privé exige d'abord « docker login ». Pour mettre à jour, changez
# la version puis lancez « update ».
SUREAU_IMAGE=sureau:local
