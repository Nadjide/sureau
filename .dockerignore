# Only the inputs required to build the application enter the build context.
**
!Dockerfile
!.dockerignore
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/sureau.svg
!frontend/public/theme.js
!backend/
!backend/pom.xml
!backend/mvnw
!backend/.mvn/
!backend/.mvn/wrapper/
!backend/.mvn/wrapper/maven-wrapper.properties
!backend/src/
!backend/src/main/
!backend/src/main/java/
!backend/src/main/java/**
!backend/src/main/resources/
!backend/src/main/resources/application.properties
!backend/src/main/resources/db/
!backend/src/main/resources/db/migration/
!backend/src/main/resources/db/migration/*.sql

# These exclusions also apply inside otherwise permitted source directories.
**/AGENTS.md
**/AGENTS*.md
**/agents.md
**/.git
**/.git/**
**/.env
**/.env.*
**/*.env
**/*.env.*
**/node_modules
**/node_modules/**
**/target
**/target/**
**/dist
**/dist/**
**/docs
**/docs/**
**/media
**/media/**
**/private
**/private/**
**/secrets
**/secrets/**
**/credentials
**/credentials/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.log
**/*.mp4
**/*.test.ts
**/*.test.tsx
