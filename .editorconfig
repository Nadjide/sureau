# Mise en forme commune aux éditeurs : https://editorconfig.org
# Les fins de ligne sont réglées par Git (.gitattributes) ; le frontend est mis en forme par Prettier.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[pom.xml]
indent_style = tab

[*.ps1]
charset = utf-8-bom
indent_size = 4

[*.md]
trim_trailing_whitespace = false
